[submodule "build/buildroot"]
	path = build/buildroot
	url = https://github.com/buildroot/buildroot.git
	branch = 2025.08.x
[submodule "build/linux-stable"]
	path = build/linux-stable
	url = https://github.com/SolidRun/linux-stable.git
	branch = rz-6.1-cip43
	shallow = true
