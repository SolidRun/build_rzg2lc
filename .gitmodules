	branch = v2024.07-rzv2n_1.2.0
[submodule "build/cyw-fmac"]
	path = build/cyw-fmac
	url = https://github.com/SolidRun/cyw-fmac.git
	branch = imx-kirkstone-jaculus
[submodule "build/linux-stable-vlp4"]
